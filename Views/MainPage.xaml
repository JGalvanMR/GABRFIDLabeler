<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GABRFIDLabeler.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:GABRFIDLabeler.Converters"
    xmlns:models="clr-namespace:GABRFIDLabeler.Models"
    xmlns:viewmodels="clr-namespace:GABRFIDLabeler.ViewModels"
    Title="Impresión RFID"
    x:DataType="{x:Type viewmodels:PrinterViewModel}">

    <ContentPage.BackgroundColor>
        <AppThemeBinding Dark="#0B0B10" Light="#F8FAFC" />
    </ContentPage.BackgroundColor>

    <!--  ==================== RECURSOS ====================  -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:RadioButtonValueToCheckedConverter x:Key="RadioConverter" />

            <!--  Paleta de colores centralizada  -->
            <Color x:Key="PrimaryLight">#2563EB</Color>
            <Color x:Key="PrimaryDark">#3B82F6</Color>
            <Color x:Key="SuccessLight">#059669</Color>
            <Color x:Key="SuccessDark">#10B981</Color>
            <Color x:Key="WarningLight">#D97706</Color>
            <Color x:Key="WarningDark">#F59E0B</Color>
            <Color x:Key="DangerLight">#DC2626</Color>
            <Color x:Key="DangerDark">#EF4444</Color>
            <Color x:Key="PurpleLight">#7C3AED</Color>
            <Color x:Key="PurpleDark">#8B5CF6</Color>

            <!--  Fondos  -->
            <Color x:Key="BgPageLight">#F8FAFC</Color>
            <Color x:Key="BgPageDark">#0B0B10</Color>
            <Color x:Key="BgCardLight">#FFFFFF</Color>
            <Color x:Key="BgCardDark">#151520</Color>
            <Color x:Key="BgInputLight">#F1F5F9</Color>
            <Color x:Key="BgInputDark">#1A1A2E</Color>

            <!--  Textos  -->
            <Color x:Key="TextPrimaryLight">#0F172A</Color>
            <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
            <Color x:Key="TextSecondaryLight">#64748B</Color>
            <Color x:Key="TextSecondaryDark">#94A3B8</Color>
            <Color x:Key="TextMutedLight">#94A3B8</Color>
            <Color x:Key="TextMutedDark">#475569</Color>

            <!--  Borders  -->
            <Color x:Key="BorderLight">#E2E8F0</Color>
            <Color x:Key="BorderDark">#2A2A40</Color>

            <!--  ==================== ESTILOS ====================  -->

            <!--  Entry plano  -->
            <Style x:Key="FlatEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!--  Frame contenedor de inputs  -->
            <Style x:Key="InputContainer" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgInputLight}, Dark={StaticResource BgInputDark}}" />
            </Style>

            <!--  Botón principal  -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="TextColor" Value="White" />
            </Style>

            <!--  Botón secundario/outline  -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="1.5" />
            </Style>

            <!--  Card principal  -->
            <Style x:Key="MainCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgCardLight}, Dark={StaticResource BgCardDark}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#1E1E30}" />
            </Style>

            <!--  Card de estadísticas  -->
            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgCardLight}, Dark={StaticResource BgCardDark}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#1E1E30}" />
            </Style>

            <!--  Label de sección  -->
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Style>

            <!--  Label de input  -->
            <Style x:Key="InputLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="4,0,0,8" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </Style>

            <!--  Badge/Tag  -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

            <!--  Segmented control: RadioButton sin círculo, con estado seleccionado visible  -->
            <ControlTemplate x:Key="SegmentTemplate">
                <Grid x:DataType="{x:Null}" HeightRequest="40">
                    <BoxView CornerRadius="9" Color="Transparent">
                        <BoxView.Triggers>
                            <DataTrigger
                                Binding="{Binding IsChecked, Source={RelativeSource TemplatedParent}}"
                                TargetType="BoxView"
                                Value="True">
                                <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="{TemplateBinding Content}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                    Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsChecked, Source={RelativeSource TemplatedParent}}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </ControlTemplate>

            <Style x:Key="SegmentRadio" TargetType="RadioButton">
                <Setter Property="ControlTemplate" Value="{StaticResource SegmentTemplate}" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <!--  Contenedor del segmented control  -->
            <Style x:Key="SegmentContainer" TargetType="Border">
                <Setter Property="Padding" Value="4" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BgInputLight}, Dark={StaticResource BgInputDark}}" />
            </Style>

            <!--  Visual States para botones  -->
            <Style TargetType="Button">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.85" />
                                    <Setter Property="Scale" Value="0.98" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.5" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--  Visual States para Cards táctiles  -->
            <Style x:Key="InteractiveCard" TargetType="Border">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#1E1E35}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!--  ==================== CONTENIDO ====================  -->
    <!--  Escritorio: panel lateral (configuración) + área principal (trabajo del modo activo)  -->
    <Grid ColumnDefinitions="400,*">

        <!--  ===== PANEL LATERAL =====  -->
        <ScrollView Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark=#0F0F16}">
            <VerticalStackLayout Padding="20,16" Spacing="16">

            <!--  ===== HEADER =====  -->
            <Grid
                Margin="0,4,0,0"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">
                <Border
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                      Dark={StaticResource PrimaryDark}}"
                    HeightRequest="48"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="48">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="RF"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Impresión de Etiquetas RFID"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                    Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        FontSize="12"
                        Text="Sistema de gestión y trazabilidad"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                    Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Grid>

            <!--  ===== CONEXIÓN =====  -->
            <Border Style="{StaticResource MainCard}">
                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.04"
                        Radius="20"
                        Offset="0,6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <!--  Header de sección  -->
                    <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                              Dark=#1E3A5F}"
                            HeightRequest="36"
                            Stroke="Transparent"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="⚙"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                            Dark={StaticResource PrimaryDark}}"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource SectionLabel}" Text="Impresora" />
                    </HorizontalStackLayout>

                    <!--  Estado de conexión  -->
                    <Border
                        Grid.Column="1"
                        Padding="10,4"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                          Dark=#1E1E30}"
                        HorizontalOptions="End"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 20"
                        VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsPrinterConnected}" TargetType="Border" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6">
                            <BoxView
                                CornerRadius="4"
                                HeightRequest="8"
                                VerticalOptions="Center"
                                WidthRequest="8"
                                Color="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                        Dark={StaticResource TextMutedDark}}">
                                <BoxView.Triggers>
                                    <DataTrigger Binding="{Binding IsPrinterConnected}" TargetType="BoxView" Value="True">
                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="Desconectada"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                            Dark={StaticResource TextSecondaryDark}}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding IsPrinterConnected}" TargetType="Label" Value="True">
                                        <Setter Property="Text" Value="Conectada" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                    </Grid>

                    <!--  IP + Conectar en una fila  -->
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
<VerticalStackLayout Grid.Row="0" Spacing="4">
                        <Label Style="{StaticResource InputLabel}" Text="Dirección IP" />
                        <Border Style="{StaticResource InputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="{OnPlatform iOS=SF Pro Display,
                                                            Android=monospace}"
                                    FontSize="16"
                                    Text="🌐"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                Dark={StaticResource TextMutedDark}}"
                                    VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Keyboard="Url"
                                    Placeholder="192.168.1.100"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                       Dark={StaticResource TextMutedDark}}"
                                    Style="{StaticResource FlatEntry}"
                                    ReturnCommand="{Binding ConnectCommand}"
                                    ReturnType="Go"
                                    Text="{Binding PrinterIp}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                Dark={StaticResource TextPrimaryDark}}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
<Button
                        Grid.Row="1"
                        Command="{Binding ConnectCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Text="Conectar">
                        <Button.BackgroundColor>
                            <AppThemeBinding Dark="{StaticResource PrimaryDark}" Light="{StaticResource PrimaryLight}" />
                        </Button.BackgroundColor>
                        <Button.Shadow>
                            <Shadow
                                Brush="{StaticResource PrimaryLight}"
                                Opacity="0.2"
                                Radius="12"
                                Offset="0,4" />
                        </Button.Shadow>
                    </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  ===== SELECTOR DE EMPRESA =====  -->
            <Border Style="{StaticResource MainCard}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                              Dark=#1E3A5F}"
                            HeightRequest="32"
                            Stroke="Transparent"
                            WidthRequest="32">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="🏢"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            CharacterSpacing="0.8"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="EMPRESA"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                        Dark={StaticResource TextMutedDark}}" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource SegmentContainer}">
<Grid ColumnDefinitions="*,*" ColumnSpacing="4">
<RadioButton Grid.Column="0" WidthRequest="154" HorizontalOptions="Start" Content="GAB" GroupName="Empresa" IsChecked="{Binding IsGABChecked}" Style="{StaticResource SegmentRadio}" />
<RadioButton Grid.Column="1" WidthRequest="154" HorizontalOptions="Start" Content="AGUILARES" GroupName="Empresa" IsChecked="{Binding IsAguilaresChecked}" Style="{StaticResource SegmentRadio}" />
</Grid>
</Border>

                    <Label
                        FontSize="11"
                        IsVisible="{Binding IsAguilaresVisible}"
                        Text="⚠️ La numeración debe ser ≥ 100000"
                        TextColor="{AppThemeBinding Light={StaticResource WarningLight},
                                                    Dark={StaticResource WarningDark}}" />
                </VerticalStackLayout>
            </Border>

            <!--  ===== SELECTOR DE MODO (Segmented Control mejorado) =====  -->
            <Border Style="{StaticResource MainCard}">
                <Border.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Light=#000000,
                                                Dark=#000000}"
                        Opacity="0.04"
                        Radius="20"
                        Offset="0,6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                              Dark=#1E1E30}"
                            HeightRequest="32"
                            Stroke="Transparent"
                            WidthRequest="32">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="⚡"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            CharacterSpacing="0.8"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="MODO DE OPERACIÓN"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                        Dark={StaticResource TextMutedDark}}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource SegmentContainer}">
<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
<RadioButton Grid.Row="0" WidthRequest="312" HorizontalOptions="Start" Content="Parámetros" GroupName="Modo" IsChecked="{Binding SelectedMode, Converter={StaticResource RadioConverter}, ConverterParameter=Impresion, Mode=Default}" Style="{StaticResource SegmentRadio}" />
<RadioButton Grid.Row="1" WidthRequest="312" HorizontalOptions="Start" Content="Reimpresión" GroupName="Modo" IsChecked="{Binding SelectedMode, Converter={StaticResource RadioConverter}, ConverterParameter=Reimpresion, Mode=Default}" Style="{StaticResource SegmentRadio}" />
<RadioButton Grid.Row="2" WidthRequest="312" HorizontalOptions="Start" Content="Nueva Etiqueta" GroupName="Modo" IsChecked="{Binding SelectedMode, Converter={StaticResource RadioConverter}, ConverterParameter=NuevaEtiqueta, Mode=Default}" Style="{StaticResource SegmentRadio}" />
</Grid>
</Border>
                </VerticalStackLayout>
            </Border>

            <!--  ===== ESTADÍSTICAS =====  -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!--  Stat 1  -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource PrimaryLight}"
                            Opacity="0.06"
                            Radius="16"
                            Offset="0,4" />
                    </Border.Shadow>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <BoxView
                                CornerRadius="3"
                                HeightRequest="8"
                                VerticalOptions="Center"
                                WidthRequest="8"
                                Color="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                        Dark={StaticResource PrimaryDark}}" />
                            <Label
                                CharacterSpacing="0.5"
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="IMPRESAS"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            FontAttributes="Bold"
                            FontSize="32"
                            HorizontalOptions="Center"
                            Text="{Binding TotalReimpresosTanda}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                        Dark={StaticResource PrimaryDark}}" />
                        <Label
                            FontSize="11"
                            HorizontalOptions="Center"
                            Opacity="0.7"
                            Text="etiquetas totales"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Stat 2  -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource SuccessLight}"
                            Opacity="0.06"
                            Radius="16"
                            Offset="0,4" />
                    </Border.Shadow>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <BoxView
                                CornerRadius="3"
                                HeightRequest="8"
                                VerticalOptions="Center"
                                WidthRequest="8"
                                Color="{AppThemeBinding Light={StaticResource SuccessLight},
                                                        Dark={StaticResource SuccessDark}}" />
                            <Label
                                CharacterSpacing="0.5"
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="EN LOTE"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label
                            FontAttributes="Bold"
                            FontSize="32"
                            HorizontalOptions="Center"
                            Text="{Binding LabelsToPrint}"
                            TextColor="{AppThemeBinding Light={StaticResource SuccessLight},
                                                        Dark={StaticResource SuccessDark}}" />
                        <Label
                            FontSize="11"
                            HorizontalOptions="Center"
                            Opacity="0.7"
                            Text="pendientes"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>


            </VerticalStackLayout>
        </ScrollView>

        <!--  ===== ÁREA PRINCIPAL =====  -->
        <Grid Grid.Column="1" Padding="24,16">
            <!--  ===== PARÁMETROS DE IMPRESIÓN =====  -->
            <Border
                HorizontalOptions="Fill"
                MaximumWidthRequest="720"
                IsVisible="{Binding IsImpresionVisible}"
                Style="{StaticResource MainCard}"
                VerticalOptions="Start">
                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.04"
                        Radius="20"
                        Offset="0,6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                              Dark=#1E3A5F}"
                            HeightRequest="36"
                            Stroke="Transparent"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="📋"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                            Dark={StaticResource PrimaryDark}}"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource SectionLabel}" Text="Parámetros de Impresión" />
                    </HorizontalStackLayout>

                    <!--  Fecha  -->
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource InputLabel}" Text="Fecha de compra" />
                        <Border Style="{StaticResource InputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="📅"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                Dark={StaticResource TextMutedDark}}"
                                    VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Placeholder="Ej. MAR-2025"
                                    Style="{StaticResource FlatEntry}"
                                    Text="{Binding Date}"
                                    TextTransform="Uppercase" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Última etiqueta  -->
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource InputLabel}" Text="Última etiqueta impresa" />
                        <Border Style="{StaticResource InputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="🏷"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                Dark={StaticResource TextMutedDark}}"
                                    VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Keyboard="Numeric"
                                    Placeholder="Número de etiqueta"
                                    Style="{StaticResource FlatEntry}"
                                    Text="{Binding LabelPrint}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Cantidad  -->
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource InputLabel}" Text="Cantidad a imprimir" />
                        <Border Style="{StaticResource InputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="🔢"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                Dark={StaticResource TextMutedDark}}"
                                    VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Keyboard="Numeric"
                                    Placeholder="Ej. 50"
                                    Style="{StaticResource FlatEntry}"
                                    Text="{Binding LabelsToPrint}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!--  Acciones  -->
                    <VerticalStackLayout Margin="0,8,0,0" Spacing="12">
                        <Button
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                            Command="{Binding PrintBatchCommand}"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="56"
                            Style="{StaticResource PrimaryButton}"
                            Text="▶  Imprimir lote de etiquetas">

                            <Button.Shadow>
                                <Shadow
                                    Brush="{StaticResource PrimaryLight}"
                                    Opacity="0.25"
                                    Radius="14"
                                    Offset="0,6" />
                            </Button.Shadow>
                        </Button>

                        <Button
                            Command="{Binding PrintSingleCommand}"
                            CornerRadius="12"
                            FontSize="14"
                            HeightRequest="44"
                            IsEnabled="False"
                            IsVisible="False"
                            Style="{StaticResource SecondaryButton}"
                            Text="Impresión simple" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  ===== REIMPRESIÓN =====  -->
            <Border IsVisible="{Binding IsReimpresionVisible}" Style="{StaticResource MainCard}">
                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.04"
                        Radius="20"
                        Offset="0,6" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">

                    <HorizontalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#F5F3FF,
                                                              Dark=#2E1065}"
                            HeightRequest="36"
                            Stroke="Transparent"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="🔄"
                                TextColor="{AppThemeBinding Light={StaticResource PurpleLight},
                                                            Dark={StaticResource PurpleDark}}"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource SectionLabel}" Text="Reimpresión de Etiquetas" />
                    </HorizontalStackLayout>

                    <!--  Input EPC  -->
                    <VerticalStackLayout Grid.Row="1" Spacing="4">
                        <Label Style="{StaticResource InputLabel}" Text="EPC o número de etiqueta" />
                        <Border Style="{StaticResource InputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="📡"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                Dark={StaticResource TextMutedDark}}"
                                    VerticalOptions="Center" />
                                <Entry
                                    x:Name="EpcEntry"
                                    Grid.Column="1"
                                    Placeholder="Escanear o escribir..."
                                    Style="{StaticResource FlatEntry}"
                                    Text="{Binding EpcToReprint}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        Grid.Row="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PurpleLight}, Dark={StaticResource PurpleDark}}"
                            Command="{Binding ReprintCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Text="↻  Reimprimir Manual">

                        <Button.Shadow>
                            <Shadow
                                Brush="{StaticResource PurpleLight}"
                                Opacity="0.25"
                                Radius="12"
                                Offset="0,4" />
                        </Button.Shadow>
                    </Button>

                    <!--  Separador  -->
                    <BoxView Grid.Row="3" HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A42}" />

                    <!--  Filtro: días sin lectura  -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource InputLabel}" Text="Días sin lectura" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry
                                    Keyboard="Numeric"
                                    Placeholder="Ej. 90"
                                    ReturnCommand="{Binding CargarSugerenciasCommand}"
                                    Style="{StaticResource FlatEntry}"
                                    Text="{Binding DiasSinLectura}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PurpleLight}, Dark={StaticResource PurpleDark}}"
                            Command="{Binding CargarSugerenciasCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Text="Buscar"
                            VerticalOptions="End"
                            WidthRequest="120" />
                    </Grid>

                    <!--  Lista de sugerencias  -->
                    <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                CharacterSpacing="1"
                                FontAttributes="Bold"
                                FontSize="10"
                                Text="SIN LECTURA RECIENTE"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                            <Border
                                Padding="6,2"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                                  Dark=#1E1E30}"
                                HorizontalOptions="Start"
                                Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="10"
                                    Text="{Binding EtiquetasSugeridas.Count, StringFormat='{}{0}'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                                Dark={StaticResource TextSecondaryDark}}" />
                            </Border>
                        </HorizontalStackLayout>

                        <Border
                            Grid.Row="1"
                            Padding="4"
                            BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#F1F5F9,
                                                     Dark=#2A2A42}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <CollectionView
                                ItemsSource="{Binding EtiquetasSugeridas}"
                                SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type models:EtiquetaPorReimprimir}">
                                        <Grid Padding="4,3">
                                            <Border
                                                Padding="14,0"
                                                BackgroundColor="{AppThemeBinding Light=#F8FAFC,
                                                                                  Dark=#16162A}"
                                                HeightRequest="56"
                                                Stroke="{AppThemeBinding Light=#E2E8F0,
                                                                         Dark=#2D2D48}"
                                                Style="{StaticResource InteractiveCard}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PrinterViewModel}}, Path=ReprintFromListCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Label
                                                        Grid.Column="0"
                                                        FontSize="14"
                                                        Text="🏷"
                                                        TextColor="{AppThemeBinding Light={StaticResource PurpleLight},
                                                                                    Dark={StaticResource PurpleDark}}"
                                                        VerticalOptions="Center" />
                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Spacing="2"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            Text="{Binding IdClaveInt}"
                                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                                                        Dark={StaticResource TextPrimaryDark}}" />
                                                        <Label
                                                            FontSize="11"
                                                            Text="{Binding DetalleTexto}"
                                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                                    </VerticalStackLayout>
                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="10,4"
                                                        BackgroundColor="{AppThemeBinding Light=#FEF3C7,
                                                                                          Dark=#3B2A0A}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 20"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="12"
                                                            Text="{Binding DiasTexto}"
                                                            TextColor="{AppThemeBinding Light={StaticResource WarningLight},
                                                                                        Dark={StaticResource WarningDark}}" />
                                                    </Border>
                                                    </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.EmptyView>
                                    <VerticalStackLayout
                                        Padding="20,50"
                                        HorizontalOptions="Center"
                                        Spacing="12"
                                        VerticalOptions="Center">
                                        <Border
                                            Padding="0"
                                            BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                                              Dark=#1A1A30}"
                                            HeightRequest="64"
                                            HorizontalOptions="Center"
                                            Stroke="Transparent"
                                            WidthRequest="64">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Label
                                                FontSize="28"
                                                HorizontalOptions="Center"
                                                Text="📭"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="Sin etiquetas por reimprimir"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                        <Label
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Opacity="0.7"
                                            Text="Ninguna etiqueta supera los días sin lectura indicados"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                        Dark={StaticResource TextMutedDark}}" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!--  ===== NUEVAS ETIQUETAS =====  -->
            <Border
                HorizontalOptions="Fill"
                MaximumWidthRequest="720"
                IsVisible="{Binding IsNuevaEtiquetaVisible}"
                Style="{StaticResource MainCard}"
                VerticalOptions="Start">
                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.04"
                        Radius="20"
                        Offset="0,6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5,
                                                              Dark=#064E3B}"
                            HeightRequest="36"
                            Stroke="Transparent"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="🏷"
                                TextColor="{AppThemeBinding Light={StaticResource SuccessLight},
                                                            Dark={StaticResource SuccessDark}}"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource SectionLabel}" Text="Nuevas Etiquetas" />
                    </HorizontalStackLayout>

                    <!--  Input EPC Nueva  -->
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource InputLabel}" Text="EPC o número de etiqueta" />
                        <Border Style="{StaticResource InputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    FontSize="16"
                                    Text="📡"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight},
                                                                Dark={StaticResource TextMutedDark}}"
                                    VerticalOptions="Center" />
                                <Entry
                                    x:Name="EpcEntryNEW"
                                    Grid.Column="1"
                                    Placeholder="Escanear o escribir..."
                                    ReturnCommand="{Binding ReprintNCommand}"
                                    ReturnType="Send"
                                    Style="{StaticResource FlatEntry}"
                                    Text="{Binding EpcToReprintN}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}"
                            Command="{Binding ReprintNCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Text="✓  Reimprimir etiqueta">

                        <Button.Shadow>
                            <Shadow
                                Brush="{StaticResource SuccessLight}"
                                Opacity="0.25"
                                Radius="12"
                                Offset="0,4" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
